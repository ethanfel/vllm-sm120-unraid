# The target model is public, so HF_TOKEN is optional. It is useful for private
# models and to avoid anonymous Hub rate limits.
HF_TOKEN=

# Leave empty for an unauthenticated LAN endpoint. If set, use the same value in
# the ComfyUI/OpenAI-compatible client.
API_KEY=

MODEL_ID=DavidAU/Qwen3.6-27B-Fable-Fusion-711-Uncensored-Heretic-NM-DAU-MTP
SERVED_MODEL_NAME=qwen3.6-27b-fable

# Stable single-RTX-PRO-6000 BF16 profile. The model supports 262144 natively,
# but 131072 leaves safer headroom for CUDA graphs, vision, and concurrent use.
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192

# Fully unload vLLM after ten idle minutes, and do not launch unless enough
# VRAM is free. Idle ComfyUI caches can be released automatically.
ENABLE_ON_DEMAND=true
IDLE_TIMEOUT_SECONDS=600
MODEL_LOAD_TIMEOUT_SECONDS=1200
MODEL_STOP_TIMEOUT_SECONDS=120
MIN_FREE_VRAM_MIB=90000
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_FREE_TIMEOUT_SECONDS=120
VLLM_INTERNAL_PORT=8001

ENABLE_PREFIX_CACHING=true
ENABLE_TOOLS=true
TOOL_CALL_PARSER=qwen3_coder
ENABLE_MTP=false
LANGUAGE_MODEL_ONLY=false
LIMIT_MM_PER_PROMPT={"image":4,"video":0}
DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking":true,"preserve_thinking":true}

# Optional experimental memory/performance setting, e.g. fp8 on supported paths.
KV_CACHE_DTYPE=
